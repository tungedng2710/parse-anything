# OpenAI-compatible vLLM endpoint. Use 127.0.0.1 instead when running outside Docker.
VLLM_URL=http://host.docker.internal:8888/v1
MONKEYOCR_MODEL=MonkeyOCRv2
MONKEYOCR_API_KEY=not-required
MONKEYOCR_MAX_PIXELS=1003520
# The official demo uses layout detection followed by recognition of each crop.
MONKEYOCR_PIPELINE_MODE=staged
MONKEYOCR_KEEP_HEADER_FOOTER=false

# Application server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Upload and rendering limits
MAX_UPLOAD_MB=30
MAX_PDF_PAGES=20
MAX_IMAGE_SIDE=3200
MIN_IMAGE_PIXELS=1003520
MAX_PREVIEW_SIDE=1200
PDF_RENDER_DPI=200

# OCR requests
OCR_CONCURRENCY=3
OCR_TIMEOUT_SECONDS=300
OCR_HTTP_RETRIES=5
OCR_RETRY_BACKOFF_SECONDS=1
OCR_REPEAT_RETRIES=3

# Optional: used only when MONKEYOCR_PIPELINE_MODE=end2end.
# MONKEYOCR_PROMPT=List the document elements in reading order, including their categories, coordinates, and the content of each element.
